# Merge these settings into K9's main Nav2 parameter file.
# Jazzy defaults many cmd_vel publishers/subscribers to geometry_msgs/Twist;
# ros2_control's diff_drive_controller uses geometry_msgs/TwistStamped.
# Enable stamped velocity on every Nav2 component in K9's active cmd_vel chain.

controller_server:
  ros__parameters:
    enable_stamped_cmd_vel: true

behavior_server:
  ros__parameters:
    enable_stamped_cmd_vel: true

# Include only if K9 uses nav2_velocity_smoother.
velocity_smoother:
  ros__parameters:
    enable_stamped_cmd_vel: true

# Include only if K9 uses nav2_collision_monitor.
collision_monitor:
  ros__parameters:
    enable_stamped_cmd_vel: true

# IMPORTANT REMAPPING:
# The final velocity-producing/safety component in the Nav2 chain must publish
# to /diff_drive_controller/cmd_vel rather than a generic /cmd_vel topic.
# If Collision Monitor is used, keep it LAST in the post-processing chain and
# remap its output to /diff_drive_controller/cmd_vel.
